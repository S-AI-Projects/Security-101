{
  "allowlisted_cidr": "192.0.2.0/24",
  "scenarios": {
    "normal": {
      "input_address": "192.0.2.1",
      "expected_allowlisted": true,
      "expected_exit_code": 0
    },
    "boundary": {
      "input_address": "198.51.100.1",
      "expected_allowlisted": false,
      "expected_exit_code": 0
